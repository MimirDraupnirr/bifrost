{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bifröst",
  "version": "0.0.0",
  "identifier": "io.github.mimirdraupnirr.bifrost",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "Bifröst",
        "url": "index.html",
        "width": 360,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/bifrost"
    ],
    "category": "Utility",
    "shortDescription": "Uploader et cross-seeder sur Draupnirr",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MENENzdCMkZGNjVBQ0UKUldUT1d2WXZlOWNNZFBOcy9aTnRwL0wwelMvQW0rSXAyQ2tHOFhWTEdKdVBKbitrcnRRZmRyN2kK",
      "endpoints": [
        "https://github.com/MimirDraupnirr/bifrost/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}